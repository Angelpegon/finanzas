# Fallback si el Document Root de Plesk apunta a la raíz del proyecto
# (httpdocs/finanzas) en lugar de /public. Preferible: Domains → Hosting Settings →
# Document Root = .../finanzas/public y entonces este archivo no se usa.

<IfModule mod_authz_core.c>
    <FilesMatch "(?i)^\.(env|git|gitignore|gitattributes|editorconfig)">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Bloquear rutas sensibles si el docroot es la raíz del repo
    RewriteRule ^(app|bootstrap|config|database|docs|lang|node_modules|resources|routes|scripts|storage|tests|vendor)(/|$) - [F,L]

    # Raíz /finanzas/ → front controller directo.
    # Sin esto, Apache DirectoryIndex/rewrite a public/ puede devolver 405 en "/".
    RewriteRule ^$ public/index.php [L]
    RewriteRule ^index\.php$ public/index.php [L]

    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
