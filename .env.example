APP_NAME=Finanzas
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Producción en subcarpeta Plesk (ej. https://ingeer.co/finanzas):
# APP_URL=https://ingeer.co/finanzas
# El path de APP_URL prefija rutas, assets, sesión y PWA. Luego: php artisan config:cache && route:cache
# Producción en raíz de dominio: APP_URL=https://finanzas.ejemplo.com (sin path)
FORCE_HTTPS=false
# Proxies de confianza (Plesk). '*' = cualquiera; en nodos propios: 127.0.0.1,::1
TRUSTED_PROXIES=*
# Solo para HMR desde otro dispositivo en la red (móvil). En local déjalo en localhost.
VITE_DEV_HOST=localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=finanzas
DB_USERNAME=root
DB_PASSWORD=
# En Plesk: host suele ser localhost; usuario/DB los crea el panel (no uses root).

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Producción HTTPS: SESSION_SECURE_COOKIE=true
SESSION_SECURE_COOKIE=

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

APP_TIMEZONE=America/Bogota
